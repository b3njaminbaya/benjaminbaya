# Backend API URL (defaults to Render deployment if not set)
VITE_API_URL=http://localhost:5001

# Public site URL — used for canonical URLs, sitemap and structured data
# VITE_SITE_URL=https://benjaminbaya.com

# ─── Contact form (server-side only — read by api/contact.mjs) ───────────────
# No VITE_ prefix on purpose: these must never be bundled into the browser code.
# Set the same values in Vercel → Project → Settings → Environment Variables.
# Create a key with "Sending access" at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender; requires benjaminbaya.com to be verified in Resend.
# Without it, Resend's test sender is used (delivers only to the account owner).
# CONTACT_FROM=Benjamin Baya <contact@benjaminbaya.com>
# Optional: inbox that receives enquiries (defaults to b3njaminbaya@gmail.com)
# CONTACT_TO=b3njaminbaya@gmail.com
